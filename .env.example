# Base de données (docker compose up -d)
DATABASE_URL="postgresql://rideau:rideau@localhost:5432/rideau"

# Espace admin : secret de session (générer avec : openssl rand -base64 32)
ADMIN_SESSION_SECRET="remplacer-par-une-longue-valeur-aleatoire"

# Compte admin créé par le seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changer-ce-mot-de-passe"

# URL publique du site (pour afficher les images dans l'admin)
WEB_URL="http://localhost:3000"

# ---------- Site public ----------
# NOM DU PROJET : affiché dans l’en-tête, le pied de page, l’onglet du navigateur, les e-mails, les billets PDF et l’admin
SITE_NAME="Rideau"
SITE_URL="http://localhost:3000"
# Secret de session des clients (différent de celui de l'admin) : openssl rand -base64 32
CUSTOMER_SESSION_SECRET="remplacer-par-une-autre-longue-valeur-aleatoire"
# Secret de la tâche planifiée /api/cron/expire
CRON_SECRET="remplacer-par-un-secret"

# ---------- Paiement carte (Stripe) ----------
# Laisser vide pour désactiver. Clés de test : dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Webhook : stripe listen --forward-to localhost:3000/api/webhooks/stripe  (affiche le secret whsec_...)
STRIPE_WEBHOOK_SECRET=""

# ---------- Paiement crypto (NOWPayments) ----------
# Laisser vide pour désactiver. Sandbox : https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_API_URL="https://api-sandbox.nowpayments.io/v1"

# ---------- E-mails (Resend) ----------
# Sans clé, les e-mails sont affichés dans la console (développement)
RESEND_API_KEY=""
MAIL_FROM="Mon Nom <billets@votre-domaine.fr>"

# ---------- Virement bancaire ----------
# Secret partagé entre le site et l’admin (confirmation des virements) : au moins 32 caractères
INTERNAL_API_SECRET="dev-secret-interne-a-remplacer-1234567890"
# Adresse de l’admin (lien dans l’e-mail « virement à vérifier ») et du site vu depuis l’admin
ADMIN_URL="http://localhost:3001"
# Durée de réservation des places en attendant le virement (heures, 1 à 168 ; défaut 48)
BANK_HOLD_HOURS="48"
# Qui prévenir quand une preuve arrive (séparés par des virgules ; défaut : tous les administrateurs)
BANK_NOTIFY_EMAIL=""

# ---------- Tests en ligne gratuits (Vercel) ----------
# Taille maximale d'un envoi de fichier en Mo (Vercel limite les requêtes à 4,5 Mo : mettre 4)
MAX_UPLOAD_MB="5"
# Pour un site de TEST déployé en mode production : n'empêche pas le démarrage si la configuration est incomplète
SKIP_ENV_CHECK=""

# ---------- Stockage des images (obligatoire en production ; en local, dossier du site) ----------
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="0"
