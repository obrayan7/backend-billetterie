# ============================================================
# CONFIGURATION DE PRODUCTION — à copier en .env.production
# Ne JAMAIS committer ce fichier une fois rempli.
# ============================================================

# --- NOM DU PROJET (en-tête, e-mails, billets PDF, admin) : à définir pour le site ET pour l’admin
SITE_NAME=Rideau

# --- Domaine (sans https://) : le site sera sur monsite.fr et l'admin sur admin.monsite.fr
DOMAIN=monsite.fr

# --- Base de données (conteneur PostgreSQL du docker-compose)
POSTGRES_USER=rideau
POSTGRES_PASSWORD=GENERER-UN-MOT-DE-PASSE-LONG
POSTGRES_DB=rideau
# Base managée à la place (Scaleway, Neon…) : retirer le service « db » du compose et définir DATABASE_URL ici.

# --- Secrets de session : deux valeurs DIFFÉRENTES, générées avec  openssl rand -base64 32
CUSTOMER_SESSION_SECRET=
ADMIN_SESSION_SECRET=
# Secret de la tâche d'expiration des commandes
CRON_SECRET=

# --- Compte administrateur créé par « npm run db:seed » (changez-le dès la première connexion)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paiement par carte : Stripe (clés de PRODUCTION : sk_live_…)
STRIPE_SECRET_KEY=
# Secret du webhook déclaré sur https://monsite.fr/api/webhooks/stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=

# --- Paiement crypto : NOWPayments (clés de PRODUCTION)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# --- E-mails : Resend (domaine d'envoi vérifié : SPF, DKIM, DMARC)
RESEND_API_KEY=
MAIL_FROM="Mon Nom <billets@monsite.fr>"

# --- Stockage des images : S3 compatible, hébergé dans l'UE
# Exemple Scaleway : S3_ENDPOINT=https://s3.fr-par.scw.cloud  S3_REGION=fr-par
# Exemple Cloudflare R2 : S3_ENDPOINT=https://<id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Adresse publique de lecture des images (bucket public ou domaine CDN), sans « / » final
S3_PUBLIC_URL=
# Mettre à 1 si votre fournisseur exige les URL « path-style »
S3_FORCE_PATH_STYLE=0

# --- Virement bancaire
# Secret partagé site <-> admin (>= 32 caractères, openssl rand -base64 32). Sert à confirmer les virements.
INTERNAL_API_SECRET=
# Adresse publique de l'admin (lien dans l'e-mail « virement à vérifier »)
ADMIN_URL=https://admin.monsite.fr
# Durée de réservation des places en attendant le virement, en heures (1 à 168)
BANK_HOLD_HOURS=48
# Destinataires des notifications de preuve de virement (séparés par des virgules ; vide = tous les administrateurs)
BANK_NOTIFY_EMAIL=
